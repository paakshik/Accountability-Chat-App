# Copy to .env and load it however you prefer, e.g.:
#   node --env-file=.env artifacts/api-server/dist/index.mjs
# Nothing here is required to boot the app — every value has a working default or
# degrades to a logged no-op.

# --- API server -------------------------------------------------------------
# Port the Express API listens on. Replit injects this; locally it defaults to 8080.
# PORT=8080

# Where the SQLite file and ladder.json live. Relative paths resolve against the
# process working directory. Defaults to ".data".
# ACCOUNTABILITY_DATA_DIR=.data
# ACCOUNTABILITY_DB_FILE=accountability.sqlite

# --- Web app ----------------------------------------------------------------
# Vite dev/preview port and base path. Replit injects these; locally they default
# to 18666 and "/".
# PORT=18666
# BASE_PATH=/

# Where the Vite dev server proxies /api. Set API_PORT if the API is not on 8080,
# or API_PROXY_TARGET for a full origin.
# API_PORT=8080
# API_PROXY_TARGET=http://127.0.0.1:8080

# --- Chat (required for the accountability partner to answer) ---------------
# Google Gemini API key from https://aistudio.google.com/apikey
# Without it the /api/chat route returns 503 rather than a fabricated reply.
# The api-server loads .env automatically on start.
# GEMINI_API_KEY=...
# GOOGLE_API_KEY is accepted as a fallback name.
#
# Model used for chat. Must support generateContent AND function calling (the partner
# logs events through a log_event tool). List what your key can use with:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" https://generativelanguage.googleapis.com/v1beta/models
#
# NOTE ON QUOTA: the Gemini free tier allows only 20 generateContent requests per day
# PER MODEL. The default (gemini-3.1-flash-lite) has more headroom than a full flash
# model. Enable billing, or switch models, if chat starts returning 429.
# ACCOUNTABILITY_MODEL=gemini-3.1-flash-lite

# --- Twilio: the part that reaches your phone -------------------------------
# Two delivery paths. Direct credentials win when both are present.
#
# 1. DIRECT (works anywhere — local machine, VPS, container). This is the only
#    path that can text or call you outside Replit. Get these from the Twilio
#    console at https://console.twilio.com
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
#
# 2. REPLIT CONNECTOR — used automatically inside Replit when the Twilio
#    connector is configured and no direct credentials are set.
#
# Required for either path: the Twilio number messages are sent FROM, and the
# number they go TO. Both in E.164 format (+countrycode...).
# On a Twilio trial account the destination must be a verified number.
# TWILIO_FROM_NUMBER=+19129142161
# ACCOUNTABILITY_USER_PHONE=+919004230955
#
# Send voice calls instead of SMS for check-in reminders.
# ACCOUNTABILITY_USE_CALLS=true
#
# Verify delivery from Settings -> Outbound delivery, or:
#   curl -X POST localhost:8080/api/selftest/message #     -H 'content-type: application/json' -d '{"channel":"sms"}'
# GET /api/healthz reports which path is active.

# --- Misc -------------------------------------------------------------------
# LOG_LEVEL=info
